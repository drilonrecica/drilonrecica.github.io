---
import { experience } from '../data/experience';
import Icon from './Icon.astro';

interface Props {
	/** Slugs of published case studies; projects only link to these. */
	published: string[];
}

const { published } = Astro.props;
---

<ol class="timeline">
	{
		experience.map((employer) => (
			<li class="entry">
				<!-- The period runs down a glowing track in the margin. -->
				<div class="period tag" aria-hidden="true">
					<span class:list={[employer.end === null && 'text-plume-text']}>{employer.end ?? 'Now'}</span>
					<span class:list={['extent', employer.end === null && 'extent-current']} />
					<span>{employer.start}</span>
				</div>
				<div>
					<h3 class="text-xl">{employer.role}</h3>
					<p class="mt-1 text-muted">
						{employer.company}
						<span class="sr-only">, {employer.period}</span>
					</p>
					<p class="mt-4 max-w-[68ch]">{employer.summary}</p>

					<ul class="mt-6 border-t border-deep">
						{employer.projects.map((project) => {
							const href =
								project.caseStudy && published.includes(project.caseStudy)
									? `/work/${project.caseStudy}`
									: project.url;
							const external = href === project.url;
							return (
								<li class="grid gap-x-6 gap-y-1 border-b border-deep py-3 sm:grid-cols-[minmax(0,1fr)_11rem]">
									<div>
										{href ? (
											<a
												href={href}
												class="link inline-flex items-center gap-1.5 font-medium"
												{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
											>
												{project.name}
												{external && <Icon name="external" size={14} />}
												{external && <span class="sr-only">(opens in a new tab)</span>}
											</a>
										) : (
											<span class="font-medium">{project.name}</span>
										)}
										<p class="text-[0.9375rem] text-muted">{project.summary}</p>
									</div>
									<p class="note sm:text-right">{project.period}</p>
								</li>
							);
						})}
					</ul>
				</div>
			</li>
		))
	}
</ol>

<style>
	.timeline {
		display: grid;
		gap: 4rem;
	}

	.entry {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr);
		gap: 1.25rem;
	}

	.period {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	/* A glowing track between start and end year. */
	.extent {
		flex: 1;
		width: 2px;
		min-height: 3rem;
		background: linear-gradient(var(--glow), rgb(60 200 255 / 0.1));
		box-shadow: 0 0 8px rgb(60 200 255 / 0.5);
	}

	.period::before,
	.period::after {
		content: none;
	}

	/* The current role's track starts in plume red: you are here. */
	.extent-current {
		background: linear-gradient(var(--plume) 0 1rem, var(--glow) 1rem, rgb(60 200 255 / 0.1));
		box-shadow: 0 0 8px rgb(227 23 43 / 0.45);
	}
</style>
