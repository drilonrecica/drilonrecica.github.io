---
interface Props {
	to: string;
	title: string;
}
const { to, title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta http-equiv="refresh" content={`0; url=${to}`} />
		<link rel="canonical" href={to} />
	</head>
	<body style="margin:0;padding:2rem;background:#05070f;color:#eaf4ff;font-family:system-ui,sans-serif">
		<p>This page moved to <a href={to} style="color:#3cc8ff">{to}</a>.</p>
	</body>
</html>
