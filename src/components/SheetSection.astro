---
interface Props {
	id: string;
	title: string;
	/** Margin annotation shown under the heading, like a note beside a drawing. */
	note?: string;
}

const { id, title, note } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-deep py-16 md:py-24">
	<div class="sheet grid gap-8 md:grid-cols-[13rem_minmax(0,1fr)] md:gap-12">
		<header>
			<h2 id={`${id}-title`} class="text-2xl">{title}</h2>
			{note && <p class="note mt-3 max-w-[22ch]">{note}</p>}
		</header>
		<div>
			<slot />
		</div>
	</div>
</section>
