---
// Legacy side: every class knows every other class. Coordinates are node centres.
const legacy = [
	{ id: 'Activity', x: 60, y: 50 },
	{ id: 'Presenter', x: 170, y: 86 },
	{ id: 'RxBus', x: 44, y: 150 },
	{ id: 'Utils', x: 150, y: 190 },
	{ id: 'Network', x: 70, y: 246 },
	{ id: 'Database', x: 190, y: 262 },
];
const tangles = [
	[0, 1], [0, 2], [0, 3], [0, 5], [1, 2], [1, 3], [1, 4], [2, 3], [2, 4], [2, 5], [3, 4], [3, 5], [4, 5], [1, 5],
];

// Modular side: dependencies only point downwards.
const features = ['search', 'tickets', 'profile'];
const core = ['domain', 'data', 'design'];
const column = (index: number) => 340 + index * 84;
---

<figure class="m-0">
	<svg
		viewBox="0 0 580 330"
		class="diagram h-auto w-full"
		role="img"
		aria-labelledby="ltm-title ltm-desc"
		font-family="IBM Plex Mono, monospace"
		font-size="10"
	>
		<title id="ltm-title">From legacy to modular architecture</title>
		<desc id="ltm-desc">
			On the left, six legacy classes are connected to each other by fourteen crossing dependencies. On the right,
			the same app is split into an app module, three feature modules and three core modules, with dependencies
			pointing in one direction only.
		</desc>

		<g class="legacy">
			{
				tangles.map(([from, to], index) => (
					<line
						x1={legacy[from].x}
						y1={legacy[from].y}
						x2={legacy[to].x}
						y2={legacy[to].y}
						pathLength="1"
						class="stroke tangle"
						style={`--i:${index}`}
					/>
				))
			}
			{
				legacy.map((node) => (
					<g>
						<rect x={node.x - 34} y={node.y - 11} width="68" height="22" class="node" />
						<text x={node.x} y={node.y + 3.5} text-anchor="middle" class="label">{node.id}</text>
					</g>
				))
			}
		</g>

		<!-- Transition arrow -->
		<g class="arrow">
			<line x1="250" y1="156" x2="296" y2="156" class="markup-stroke" />
			<path d="M290 150l8 6-8 6" class="markup-stroke" fill="none" />
		</g>

		<g class="modular">
			<rect x="382" y="39" width="84" height="22" class="node" />
			<text x="424" y="53.5" text-anchor="middle" class="label">:app</text>

			{
				features.map((name, index) => (
					<g>
						<path
							d={`M424 61 V96 H${column(index) + 0} V132`}
							pathLength="1"
							fill="none"
							class="stroke clean"
							style={`--i:${index}`}
						/>
						<rect x={column(index) - 36} y="132" width="72" height="22" class="node" />
						<text x={column(index)} y="146.5" text-anchor="middle" class="label">:{name}</text>
					</g>
				))
			}

			<line x1="304" y1="196" x2="544" y2="196" pathLength="1" class="stroke clean" style="--i:3" />
			{
				features.map((_, index) => (
					<line
						x1={column(index)}
						y1="154"
						x2={column(index)}
						y2="196"
						pathLength="1"
						class="stroke clean"
						style={`--i:${index + 3}`}
					/>
				))
			}
			{
				core.map((name, index) => (
					<g>
						<line
							x1={column(index)}
							y1="196"
							x2={column(index)}
							y2="240"
							pathLength="1"
							class="stroke clean"
							style={`--i:${index + 5}`}
						/>
						<rect x={column(index) - 36} y="240" width="72" height="22" class="node" />
						<text x={column(index)} y="254.5" text-anchor="middle" class="label">:{name}</text>
					</g>
				))
			}
		</g>

		<!-- Dimension lines -->
		<g class="dimension">
			<path d="M26 300 H224 M26 294 V306 M224 294 V306" />
			<text x="125" y="320" text-anchor="middle" class="label-soft">legacy: everything depends on everything</text>
			<path d="M304 300 H544 M304 294 V306 M544 294 V306" />
			<text x="424" y="320" text-anchor="middle" class="label-soft">modular: dependencies point one way</text>
		</g>
	</svg>
</figure>

<style>
	.node {
		fill: var(--armor);
		stroke: var(--glow);
		stroke-width: 1;
	}

	.label {
		fill: var(--snow);
	}

	.label-soft {
		fill: var(--muted);
		font-size: 10px;
	}

	.stroke {
		stroke: var(--glow);
		stroke-width: 1;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		animation: draw 0.5s ease-out forwards;
	}

	.tangle {
		opacity: 0.55;
		animation-delay: calc(var(--i) * 45ms);
	}

	.clean {
		stroke-width: 1.25;
		animation-delay: calc(0.9s + var(--i) * 90ms);
	}

	.markup-stroke {
		stroke: var(--gate);
		stroke-width: 1.5;
	}

	.dimension path {
		stroke: var(--muted);
		stroke-width: 0.75;
		fill: none;
	}

	.arrow,
	.modular .node,
	.modular .label {
		opacity: 0;
		animation: appear 0.4s ease-out 0.8s forwards;
	}
</style>
