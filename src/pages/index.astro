---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SystemWindow from '../components/SystemWindow.astro';
import WorkCard from '../components/WorkCard.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import StatusWindow from '../components/StatusWindow.astro';
import { profile } from '../data/profile';
import { stackGroups } from '../data/experience';
import { getWork } from '../data/work';
import { openSource, builtElsewhere } from '../data/projects';
import portrait from '../assets/portrait.jpg';

const work = (await getWork()).filter((entry) => entry.id === 'security-library');
const github = profile.links.find((link) => link.icon === 'github')!;
const allWork = await getWork();

const principles = [
	{
		title: 'Migrate while shipping',
		body: 'A rewrite stops delivery; a migration does not have to. On Wohin Du Willst the move from MVP and RxJava to MVVM with Coroutines and Flow happens inside a production app that keeps releasing.',
	},
	{
		title: 'Accessibility is architecture',
		body: 'Meeting WCAG on a public transport app is not a final polish step. It shapes components, navigation and testing from the start.',
	},
	{
		title: 'Structure should fit the project',
		body: 'Multi-module codebases and white-label setups pay off when several teams build in parallel. Other apps are better served by a single, well-layered module. I choose the structure the project needs, not the one that is fashionable.',
	},
	{
		title: 'Own the whole system',
		body: 'For Qisara I built the Flutter app, the Deno backend and the infrastructure. Knowing every layer makes me a better mobile engineer on large teams too.',
	},
];
---

<Layout title={`${profile.name} | ${profile.title}`}>
	<section class="sheet grid items-center gap-12 py-16 md:py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)]">
		<div>
			<h1 class="text-4xl sm:text-5xl lg:text-[3.5rem]">
				{profile.headline.replace(/\.$/, '')}{profile.headline.endsWith('.') && <span class="text-plume-text">.</span>}
			</h1>
			<p class="mt-6 max-w-[58ch] text-lg text-muted">{profile.intro}</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href="#open-source" class="btn btn-primary">See projects</a>
				<a href={profile.home} target="_blank" rel="noopener noreferrer" class="btn">
					Professional profile <Icon name="external" /><span class="sr-only"> (opens in a new tab)</span>
				</a>
				<a href={github.href} target="_blank" rel="noopener noreferrer" class="btn">
					<Icon name="github" /> GitHub <Icon name="external" /><span class="sr-only"> (opens in a new tab)</span>
				</a>
			</div>
		</div>
		<StatusWindow />
	</section>

	<SystemWindow id="open-source" tag="Shadow army" title="Open source" note="Side projects, built in the open.">
		<ul class="grid gap-4">
			{
				openSource.map((project) => (
					<li class="panel p-5 sm:p-6">
						<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
							<h3 class="text-lg">{project.name}</h3>
							{project.status && <span class="note">{project.status}</span>}
							{project.arise && <span class="arise ml-auto" aria-hidden="true">Arise.</span>}
						</div>
						<p class="mt-2 max-w-[68ch] text-muted">{project.summary}</p>
						<ul class="highlights mt-3 grid gap-1 text-sm text-muted">
							{project.highlights.map((item) => (
								<li class="flex gap-2">
									<span class="text-glow-core" aria-hidden="true">▪</span>
									{item}
								</li>
							))}
						</ul>
						<div class="mt-4 flex flex-wrap items-center justify-between gap-x-8 gap-y-2">
							<p class="note">{project.stack.join(' / ')}</p>
							<ul class="flex flex-wrap gap-x-6 gap-y-2">
								{project.links.map((link) => (
									<li>
										<a href={link.href} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-2">
											<Icon name={link.icon} /> {link.label}
											<span class="sr-only">for {project.name} (opens in a new tab)</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					</li>
				))
			}
		</ul>
	</SystemWindow>

	{
		work.length > 0 && (
			<SystemWindow id="work" tag="Quest log" title="From the archive" note="Earlier open-source work.">
				<div class="grid gap-6">
					{work.map((entry) => <WorkCard entry={entry} />)}
				</div>
			</SystemWindow>
		)
	}

	<SystemWindow id="tools" tag="Tools & labs" title="More things I've built" note="Products on recica.dev subdomains.">
		<ul class="grid gap-4 sm:grid-cols-2">
			{
				builtElsewhere.map((item) => (
					<li class="panel p-5 sm:p-6">
						<h3 class="text-lg">{item.name}</h3>
						<p class="mt-2 text-muted">{item.summary}</p>
						<p class="mt-4">
							<a href={item.href} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-2">
								<Icon name="external" /> {item.host}
								<span class="sr-only">(opens in a new tab)</span>
							</a>
						</p>
					</li>
				))
			}
		</ul>
	</SystemWindow>

	<SystemWindow id="about" tag="Player" title="About">
		<div class="grid gap-8 sm:grid-cols-[minmax(0,1fr)_auto]">
			<div class="max-w-[62ch] space-y-4">
				<p>{profile.summary}</p>
				<p>
					For personal and side projects I mostly use Flutter, to prototype quickly and ship to both platforms.
				</p>
				<p>
					<a href={profile.home} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-2">
						Full background, experience and CV on recica.dev <Icon name="external" />
						<span class="sr-only">(opens in a new tab)</span>
					</a>
				</p>
				<p class="note">I work in {profile.languages.join(', ')}.</p>
			</div>
			<figure class="panel m-0 w-40 self-start p-2 max-sm:order-first sm:w-52">
				<Image
					src={portrait}
					alt={`Portrait of ${profile.name}`}
					widths={[208, 416]}
					sizes="208px"
					class="block w-full"
				/>
			</figure>
		</div>
	</SystemWindow>

	<SystemWindow id="contact" tag="System message" alert title="Contact" note="Email is the fastest way to reach me.">
		<p class="font-display text-xl font-semibold text-glow-core">A new quest has arrived.</p>
		<p class="mt-2 text-muted">Projects, roles or questions: write to me directly.</p>
		<p class="mt-6 text-2xl sm:text-3xl">
			<a href={`mailto:${profile.email}`} class="link break-all">{profile.email}</a>
		</p>
		<a href={`mailto:${profile.email}`} class="btn btn-primary mt-6">Accept<span class="sr-only"> and write an email</span></a>
		<p class="mt-8 text-muted">
			Professional profile and CV:
			<a href={profile.home} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-2">
				recica.dev <Icon name="external" />
				<span class="sr-only">(opens in a new tab)</span>
			</a>
		</p>
		<ul class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
			{
				profile.links.map((link) => (
					<li>
						<a href={link.href} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-2">
							<Icon name={link.icon} /> {link.label}
							<span class="sr-only">(opens in a new tab)</span>
						</a>
					</li>
				))
			}
			<li>
				<a href={profile.cvPdf} class="link inline-flex items-center gap-2">
					<Icon name="download" /> CV as PDF
				</a>
			</li>
		</ul>
	</SystemWindow>
	<section aria-label="Track record" class="sheet">
		<div class="window reveal">
			<p class="window-bar tag">Stats</p>
			<dl class="grid grid-cols-2 gap-px bg-deep lg:grid-cols-4">
				{
					profile.proof.map((fact) => (
						<div class="flex flex-col-reverse justify-end bg-armor px-5 py-6 sm:px-6">
							<dt class="note mt-2">{fact.label}</dt>
							<dd class="font-display text-3xl font-bold text-glow-core">{fact.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<SystemWindow id="experience" tag="Hunter record" title="Experience" note="Three employers since 2015. Client projects are listed under each.">
		<Timeline published={allWork.map((entry) => entry.id)} />
	</SystemWindow>

	<SystemWindow id="approach" tag="Passive skills" title="How I work" note="Four convictions, each one earned on a real project.">
		<div class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
			{
				principles.map((principle) => (
					<div>
						<p class="tag text-muted">Passive skill</p>
						<h3 class="mt-2 text-lg">{principle.title}</h3>
						<p class="mt-2 text-muted">{principle.body}</p>
					</div>
				))
			}
		</div>

		<p class="tag mt-16">Skills</p>
		<h3 class="mt-2 text-lg">Tools I use</h3>
		<dl class="mt-4 border-t border-deep">
			{
				stackGroups.map((group) => (
					<div class="grid gap-x-6 gap-y-1 border-b border-deep py-3 sm:grid-cols-[8rem_minmax(0,1fr)]">
						<dt class="font-medium">{group.name}</dt>
						<dd class="note self-center">{group.items.join(', ')}</dd>
					</div>
				))
			}
		</dl>
	</SystemWindow>


</Layout>
