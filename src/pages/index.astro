---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SheetSection from '../components/SheetSection.astro';
import WorkCard from '../components/WorkCard.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import LegacyToModular from '../components/diagrams/LegacyToModular.astro';
import { profile } from '../data/profile';
import { stackGroups } from '../data/experience';
import { getWork } from '../data/work';
import { openSource } from '../data/projects';
import portrait from '../assets/portrait.jpg';

const work = await getWork();

const principles = [
	{
		title: 'Migrate while shipping',
		body: 'A rewrite stops delivery; a migration does not have to. On Wohin Du Willst the move from MVP and RxJava to MVVM with Coroutines and Flow happens inside a production app that keeps releasing.',
	},
	{
		title: 'Accessibility is architecture',
		body: 'Meeting WCAG on a public transport app is not a final polish step. It shapes components, navigation and testing from the start.',
	},
	{
		title: 'Structure should fit the project',
		body: 'Multi-module codebases and white-label setups pay off when several teams build in parallel. Other apps are better served by a single, well-layered module. I choose the structure the project needs, not the one that is fashionable.',
	},
	{
		title: 'Own the whole system',
		body: 'For Qisara I built the Flutter app, the Deno backend and the infrastructure. Knowing every layer makes me a better mobile engineer on large teams too.',
	},
];
---

<Layout title={`${profile.name} | ${profile.title}`} sheet="Home">
	<section class="sheet grid items-center gap-12 py-16 md:py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
		<div>
			<p class="note">{profile.name}, {profile.title.toLowerCase()}</p>
			<h1 class="mt-4 text-4xl sm:text-5xl lg:text-[3.5rem]">{profile.headline}</h1>
			<p class="mt-6 max-w-[58ch] text-lg text-ink-soft">{profile.intro}</p>
			<div class="mt-8 flex flex-wrap gap-3">
				{work.length > 0 && <a href="#work" class="btn btn-primary">Read case studies</a>}
				<a href="/cv" class={work.length > 0 ? 'btn' : 'btn btn-primary'}>View CV</a>
				<a href={`mailto:${profile.email}`} class="btn">
					<Icon name="email" /> Email me
				</a>
			</div>
		</div>
		<div class="framed p-4 sm:p-6">
			<LegacyToModular />
			<p class="note mt-3">Fig. 1: the change I make to codebases, drawn as a dependency graph.</p>
		</div>
	</section>

	<section aria-label="Track record" class="border-t border-rule">
		<dl class="sheet grid grid-cols-2 gap-px bg-rule px-0! lg:grid-cols-4">
			{
				profile.proof.map((fact) => (
					<div class="flex flex-col-reverse justify-end bg-paper px-5 py-8 sm:px-8">
						<dt class="note mt-2">{fact.label}</dt>
						<dd class="text-3xl font-medium">{fact.value}</dd>
					</div>
				))
			}
		</dl>
	</section>

	{
		work.length > 0 && (
			<SheetSection id="work" title="Selected work" note="Three projects in detail: the challenge, what I did and what changed.">
				<div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
					{work.map((entry) => <WorkCard entry={entry} />)}
				</div>
			</SheetSection>
		)
	}

	<SheetSection id="open-source" title="Open source" note="Side projects, built in the open.">
		<ul class="border-t border-rule">
			{
				openSource.map((project) => (
					<li class="border-b border-rule py-6">
						<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
							<h3 class="text-lg">{project.name}</h3>
							{project.status && <span class="note">{project.status}</span>}
						</div>
						<p class="mt-2 max-w-[68ch] text-ink-soft">{project.summary}</p>
						<div class="mt-3 flex flex-wrap items-center justify-between gap-x-8 gap-y-2">
							<p class="note">{project.stack.join(' / ')}</p>
							<ul class="flex flex-wrap gap-x-6 gap-y-2">
								{project.links.map((link) => (
									<li>
										<a href={link.href} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-2">
											<Icon name={link.icon} /> {link.label}
											<span class="sr-only">for {project.name} (opens in a new tab)</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					</li>
				))
			}
		</ul>
	</SheetSection>

	<SheetSection id="experience" title="Experience" note="Three employers since 2015. Client projects are listed under each.">
		<Timeline published={work.map((entry) => entry.id)} />
	</SheetSection>

	<SheetSection id="approach" title="How I work" note="Four convictions, each one earned on a real project.">
		<div class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
			{
				principles.map((principle) => (
					<div>
						<h3 class="text-lg">{principle.title}</h3>
						<p class="mt-2 text-ink-soft">{principle.body}</p>
					</div>
				))
			}
		</div>

		<h3 class="mt-16 text-lg">Tools I use</h3>
		<dl class="mt-4 border-t border-rule">
			{
				stackGroups.map((group) => (
					<div class="grid gap-x-6 gap-y-1 border-b border-rule py-3 sm:grid-cols-[8rem_minmax(0,1fr)]">
						<dt class="font-medium">{group.name}</dt>
						<dd class="note self-center">{group.items.join(', ')}</dd>
					</div>
				))
			}
		</dl>
	</SheetSection>

	<SheetSection id="about" title="About">
		<div class="grid gap-8 sm:grid-cols-[minmax(0,1fr)_auto]">
			<div class="max-w-[62ch] space-y-4">
				<p>{profile.summary}</p>
				<p>
					For personal and side projects I mostly use Flutter, to prototype quickly and ship to both platforms.
				</p>
				<p class="note">I work in {profile.languages.join(', ')}.</p>
			</div>
			<figure class="framed m-0 w-40 self-start p-2 max-sm:order-first sm:w-52">
				<Image
					src={portrait}
					alt={`Portrait of ${profile.name}`}
					widths={[208, 416]}
					sizes="208px"
					class="block w-full"
				/>
			</figure>
		</div>
	</SheetSection>

	<SheetSection id="contact" title="Contact" note="Email is the fastest way to reach me.">
		<p class="text-2xl sm:text-3xl">
			<a href={`mailto:${profile.email}`} class="link break-all">{profile.email}</a>
		</p>
		<ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
			{
				profile.links.map((link) => (
					<li>
						<a href={link.href} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-2">
							<Icon name={link.icon} /> {link.label}
							<span class="sr-only">(opens in a new tab)</span>
						</a>
					</li>
				))
			}
			<li>
				<a href={profile.cvPdf} class="link inline-flex items-center gap-2">
					<Icon name="download" /> CV as PDF
				</a>
			</li>
		</ul>
	</SheetSection>
</Layout>
