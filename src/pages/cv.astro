---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { experience, stackGroups } from '../data/experience';
---

<Layout title={`CV | ${profile.name}`} description={`Curriculum vitae of ${profile.name}, ${profile.title}.`}>
	<article class="sheet cv py-12 md:py-20">
		<header class="flex flex-wrap items-end justify-between gap-6 border-b border-glow pb-6">
			<div>
				<h1 class="text-4xl sm:text-5xl">{profile.name}</h1>
				<p class="mt-2 text-xl text-muted">{profile.title}</p>
			</div>
			<div class="note space-y-1 sm:text-right">
				<p><a href={`mailto:${profile.email}`} class="link">{profile.email}</a></p>
				<p><a href="https://drilonrecica.github.io" class="link">drilonrecica.github.io</a></p>
				<p><a href={profile.links[0].href} class="link">github.com/drilonrecica</a></p>
			</div>
		</header>

		<div class="mt-6 flex flex-wrap gap-3 print:hidden">
			<button type="button" id="print-cv" class="btn btn-primary">Print or save as PDF</button>
			<a href={profile.cvPdf} class="btn"><Icon name="download" /> Download PDF</a>
		</div>

		<section class="mt-10">
			<h2 class="text-xl">Profile</h2>
			<p class="mt-3 max-w-[75ch]">{profile.summary}</p>
		</section>

		<section class="mt-10">
			<h2 class="text-xl">Experience</h2>
			{
				experience.map((employer) => (
					<div class="job mt-6 grid gap-x-8 gap-y-2 md:grid-cols-[11rem_minmax(0,1fr)]">
						<div class="note">
							<p>{employer.period}</p>
							<p>{employer.company}</p>
						</div>
						<div>
							<h3 class="text-lg">{employer.role}</h3>
							<p class="mt-2 max-w-[75ch]">{employer.summary}</p>
							<ul class="mt-3 space-y-1 text-[0.9375rem]">
								{employer.projects.map((project) => (
									<li>
										<span class="font-medium">{project.name}</span>
										<span class="text-muted"> ({project.period}). {project.summary}</span>
									</li>
								))}
							</ul>
						</div>
					</div>
				))
			}
		</section>

		<div class="mt-10 grid gap-10 md:grid-cols-2">
			<section>
				<h2 class="text-xl">Education</h2>
				{
					profile.education.map((item) => (
						<div class="mt-4">
							<h3 class="text-base">{item.title}</h3>
							<p class="note">{item.place}, {item.period}</p>
						</div>
					))
				}
				<h2 class="mt-10 text-xl">Languages</h2>
				<p class="mt-3">{profile.languages.join(', ')}</p>
			</section>
			<section>
				<h2 class="text-xl">Tools</h2>
				<dl class="mt-4 space-y-3">
					{
						stackGroups.map((group) => (
							<div>
								<dt class="font-medium">{group.name}</dt>
								<dd class="note">{group.items.join(', ')}</dd>
							</div>
						))
					}
				</dl>
			</section>
		</div>
	</article>
</Layout>

<script>
	document.addEventListener('astro:page-load', () => {
		document.getElementById('print-cv')?.addEventListener('click', () => window.print());
	});
</script>
